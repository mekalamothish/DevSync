@model DevSync.Web.Features.Settings.Command
@{ViewData["Title"]="Settings";}
<div class="mx-auto max-w-3xl space-y-6"><header><h1 class="text-3xl font-semibold">Make this space yours</h1><p class="mt-3 text-sm text-slate-500">Control your public profile and reading preferences.</p></header>
@if(TempData["Success"] is string success){<p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p>}
<form action="/account/settings" method="post" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">@Html.AntiForgeryToken()<input asp-for="Version" type="hidden"/><partial name="_ValidationSummary"/>
<div><label class="flex items-center gap-3"><input asp-for="PublicProfile" class="size-4"/>Enable my public profile</label><p class="mt-2 text-xs leading-6 text-slate-500">Shares your display name, handle, badge, and visible published articles. Your email, personal notes, tasks, teams, and verification evidence stay private.</p></div>
<label class="flex items-center gap-3"><input asp-for="ShowBio" class="size-4"/>Show my bio on my public profile</label>
<label class="flex items-center gap-3"><input asp-for="ReduceMotion" class="size-4"/>Reduce interface animation</label>
<div><label asp-for="ArticlesPageSize" class="form-label">Articles per page</label><select asp-for="ArticlesPageSize" class="form-input"><option value="12">12</option><option value="24">24</option></select><p class="mt-2 text-xs text-slate-500">Used by Explore and Saved articles when signed in.</p></div>
<button class="form-button">Save settings</button></form>
<div class="flex flex-wrap gap-5 text-sm text-brand-600"><a href="/account/profile">Edit profile →</a><a href="/account/verification">Publisher verification →</a>@if(Model.PublicProfile){<a href="/people/@Model.Handle">View public profile →</a>}</div></div>
