@model DevSync.Web.Features.Profiles.Edit.Command
@{ ViewData["Title"] = "My profile"; }
<section class="mx-auto max-w-2xl rounded-3xl border border-slate-200/70 bg-white p-7 sm:p-10" aria-labelledby="profile-title">
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-brand-600">Your developer identity</p>
    <h1 id="profile-title" class="text-3xl font-semibold tracking-tight">Make yourself at home</h1>
    <p class="mb-8 mt-3 text-sm leading-7 text-slate-500">Give your profile a name and tell us a little about what you build.</p>
    @if (TempData["Success"] is string message)
    {
        <p role="status" class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">@message</p>
    }
    <form asp-action="Edit" method="post" class="space-y-6">
        <partial name="_ValidationSummary" />
        <input asp-for="Version" type="hidden" />
        <div><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-input" autocomplete="name" /><span asp-validation-for="DisplayName" class="form-error"></span></div>
        <div><label asp-for="Handle" class="form-label"></label><input asp-for="Handle" class="form-input" autocomplete="nickname" spellcheck="false" /><span asp-validation-for="Handle" class="form-error"></span></div>
        <div><label asp-for="Bio" class="form-label"></label><textarea asp-for="Bio" class="form-input min-h-36" rows="5" maxlength="1000"></textarea><span asp-validation-for="Bio" class="form-error"></span><p class="mt-2 text-xs text-slate-600">Up to 1,000 characters. Plain text only.</p></div>
        <button type="submit" class="form-button">Save profile</button>
    </form>
</section>
