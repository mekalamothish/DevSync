@model DevSync.Web.Features.Revision.Create.Command
@{ ViewData["Title"] = "Create revision card"; }
<section class="mx-auto max-w-3xl space-y-7">
    <header><a class="text-sm font-medium text-brand-600" href="/notes/@Model.NoteId">← Back to note</a><p class="mb-2 mt-7 text-xs font-semibold uppercase tracking-widest text-brand-600">Learn a little, remember more</p><h1 class="text-3xl font-semibold tracking-tight">Create a revision card</h1><p class="mt-3 break-words text-sm leading-7 text-slate-500">From <strong class="font-medium text-slate-700">@Model.NoteTitle</strong>. Your question and answer are private, and stay independent of future note edits.</p></header>
    <form method="post" action="/revision/create" class="space-y-6 rounded-3xl border border-slate-200/70 bg-white p-6 sm:p-8">
        @Html.AntiForgeryToken()<partial name="_ValidationSummary" /><input asp-for="NoteId" type="hidden" />
        <div><label asp-for="Prompt" class="form-label"></label><textarea asp-for="Prompt" class="form-input min-h-28" maxlength="500" rows="3" placeholder="What should you be able to recall?"></textarea><span asp-validation-for="Prompt" class="form-error"></span></div>
        <div><label asp-for="Answer" class="form-label"></label><textarea asp-for="Answer" class="form-input min-h-48" maxlength="4000" rows="7" placeholder="Write the answer in your own words."></textarea><span asp-validation-for="Answer" class="form-error"></span><p class="mt-2 text-xs text-slate-500">Plain text, up to 4,000 characters. The first review is due immediately.</p></div>
        <div class="flex flex-wrap items-center gap-5"><button type="submit" class="form-button">Create card</button><a class="text-sm text-slate-500" href="/notes/@Model.NoteId">Cancel</a></div>
    </form>
</section>
