@model DevSync.Web.Features.Tasks.Common.Filters
@{
    var boardView = ViewData["BoardView"] as bool? == true;
    var boardId = ViewData["BoardId"] as Guid?;
    var boards = (IReadOnlyList<DevSync.Web.Features.Tasks.Edit.BoardChoice>)ViewData["Boards"]!;
}
<form method="get" action="@(boardView ? "/tasks/board" : "/tasks")" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5">
    <div class="grid gap-4 sm:grid-cols-2"><div><label for="task-search" class="form-label">Search tasks</label><input id="task-search" name="search" class="form-input" value="@Model.Search" maxlength="200" placeholder="Search titles and descriptions" /></div><div><label for="task-board-choice" class="form-label">Board</label><select id="task-board-choice" name="boardId" class="form-input">@if (!boardView) { <option value="">All boards</option> }@foreach (var board in boards) { <option value="@board.Id" selected="@(boardId == board.Id)">@board.Name</option> }</select></div></div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
        <div><label for="task-priority-filter" class="form-label">Priority</label><select id="task-priority-filter" name="priority" class="form-input"><option value="all" selected="@(Model.Priority == "all")">Any priority</option><option value="low" selected="@(Model.Priority == "low")">Low</option><option value="medium" selected="@(Model.Priority == "medium")">Medium</option><option value="high" selected="@(Model.Priority == "high")">High</option><option value="urgent" selected="@(Model.Priority == "urgent")">Urgent</option></select></div>
        <div><label for="task-state-filter" class="form-label">Status</label><select id="task-state-filter" name="state" class="form-input"><option value="all" selected="@(Model.State == "all")">All active</option><option value="open" selected="@(Model.State == "open")">Open</option><option value="completed" selected="@(Model.State == "completed")">Completed</option>@if (!boardView) { <option value="archived" selected="@(Model.State == "archived")">Archived</option> }</select></div>
        <div><label for="task-assignment-filter" class="form-label">Assigned to</label><select id="task-assignment-filter" name="assignment" class="form-input"><option value="all" selected="@(Model.Assignment == "all")">Anyone</option><option value="me" selected="@(Model.Assignment == "me")">Me</option><option value="unassigned" selected="@(Model.Assignment == "unassigned")">Unassigned</option></select></div>
        <div><label for="task-due-filter" class="form-label">Due date</label><select id="task-due-filter" name="due" class="form-input"><option value="all" selected="@(Model.Due == "all")">Any date</option><option value="overdue" selected="@(Model.Due == "overdue")">Overdue</option><option value="today" selected="@(Model.Due == "today")">Today</option><option value="upcoming" selected="@(Model.Due == "upcoming")">Upcoming</option><option value="none" selected="@(Model.Due == "none")">No due date</option></select></div>
        <div><label for="task-sort-filter" class="form-label">Sort</label><select id="task-sort-filter" name="sort" class="form-input"><option value="position" selected="@(Model.Sort == "position")">Board order</option><option value="due" selected="@(Model.Sort == "due")">Due date</option><option value="priority" selected="@(Model.Sort == "priority")">Priority</option><option value="newest" selected="@(Model.Sort == "newest")">Newest first</option></select></div>
    </div>
    <div class="flex flex-wrap items-center gap-4"><button class="form-button" type="submit">Apply filters</button><a class="text-sm text-slate-500" href="@(boardView ? "/tasks/board?boardId=" + boardId : "/tasks")">Clear filters</a></div>
</form>
