@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DevSync.Web.Features.Tasks.List.ViewModel
@{
    ViewData["Title"] = "My tasks";
    var filters = new DevSync.Web.Features.Tasks.Common.Filters(Model.Search, Model.Priority, Model.State, Model.Assignment, Model.Due, Model.Sort);
}
<div class="mx-auto max-w-6xl space-y-7">
    <header class="flex flex-wrap items-end justify-between gap-5"><div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-600">From ideas to progress</p><h1 class="text-4xl font-semibold tracking-tight">My tasks</h1><p class="mt-3 text-sm leading-7 text-slate-500">Plan the next step, connect what you’re learning, and see work move forward.</p></div>@if (Model.Boards.Count > 0) { <a class="form-button" href="/tasks/create?boardId=@Model.BoardId">New task ＋</a> }</header>
    @if (TempData["Error"] is string error) { <p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">@error</p> }
    @if (TempData["Success"] is string success) { <p class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    <div class="grid gap-4 sm:grid-cols-3"><div class="rounded-2xl border border-brand-100 bg-brand-50 p-5"><p class="text-sm text-brand-700">Open tasks</p><p class="mt-2 text-3xl font-semibold">@Model.Active</p></div><div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Completed</p><p class="mt-2 text-3xl font-semibold">@Model.Completed</p></div><div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Archived</p><p class="mt-2 text-3xl font-semibold">@Model.Archived</p></div></div>
    <div class="flex flex-wrap items-center justify-between gap-4"><nav class="flex gap-3 text-sm" aria-label="Task views"><a href="/tasks" class="rounded-xl bg-brand-50 px-4 py-2 font-semibold text-brand-700" aria-current="page">List</a><a href="/tasks/board?boardId=@Model.BoardId&search=@Uri.EscapeDataString(Model.Search)&priority=@Model.Priority&state=@Model.State&assignment=@Model.Assignment&due=@Model.Due&sort=@Model.Sort" class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-slate-500">Kanban board</a></nav><span class="text-xs text-slate-500">Personal boards · To do / In progress / Done</span></div>
    <details class="rounded-2xl border border-slate-200 bg-white p-5" open="@(Model.Boards.Count == 0)"><summary class="cursor-pointer text-sm font-semibold text-brand-600">Create a board</summary><form method="post" action="/tasks/boards" class="mt-4 flex flex-wrap items-end gap-3">@Html.AntiForgeryToken()<div class="min-w-48 flex-1"><label for="new-board-name" class="form-label">Board name</label><input id="new-board-name" name="Name" class="form-input" maxlength="80" required placeholder="e.g. Learning goals" /></div><button class="form-button" type="submit">Create board</button></form></details>
    @if (Model.Boards.Count == 0)
    {
        <section class="rounded-2xl border border-dashed border-slate-200 bg-white px-6 py-12 text-center"><h2 class="text-xl font-semibold">Give your plans a place to start</h2><p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">Create your first board above. Then add tasks, organize checklists, and move work from To do to Done.</p></section>
    }
    else
    {
        @await Html.PartialAsync("/Features/Tasks/Common/_Filters.cshtml", filters, new ViewDataDictionary(ViewData) { ["Boards"] = Model.Boards, ["BoardId"] = Model.BoardId, ["BoardView"] = false })
        <p class="text-xs text-slate-500">@Model.Total @(Model.Total == 1 ? "task" : "tasks") found</p>
        @if (Model.Tasks.Count == 0)
        {
            <section class="rounded-2xl border border-dashed border-slate-200 bg-white px-6 py-12 text-center"><h2 class="text-xl font-semibold">@(filters.IsFiltered ? "No tasks match these filters" : "Your next step starts here")</h2><p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">@(filters.IsFiltered ? "Try another filter or clear them to see your active tasks." : "Create a task, set a priority, and break it into small checklist items.")</p></section>
        }
        <div class="space-y-4">
            @foreach (var task in Model.Tasks)
            {
                var boardVersion = Model.Boards.First(board => board.Id == task.BoardId).Version;
                <article class="flex flex-wrap items-center justify-between gap-5 rounded-2xl border border-slate-200 bg-white p-5">
                    <div class="min-w-0 flex-1"><p class="text-xs text-slate-500">@task.BoardName · @task.ColumnName@(task.IsArchived ? " · Archived" : "")</p><h2 class="mt-2 break-words text-lg font-semibold"><a href="/tasks/@task.Id">@task.Title</a></h2><div class="mt-3 flex flex-wrap items-center gap-2 text-xs"><span class="rounded-full px-3 py-1 capitalize @(task.Priority == "urgent" ? "bg-red-50 text-red-700" : task.Priority == "high" ? "bg-amber-50 text-amber-700" : "bg-brand-50 text-brand-700")">@task.Priority priority</span><span class="text-slate-500">@(task.AssignedToMe ? "Assigned to me" : "Unassigned")</span>@if (task.DueDate is not null) { <span class="text-slate-500">Due <time datetime="@task.DueDate.Value.ToString("yyyy-MM-dd")">@task.DueDate.Value.ToString("MMM d, yyyy")</time></span> }@if (task.ChecklistTotal > 0) { <span class="text-slate-500">@task.ChecklistCompleted/@task.ChecklistTotal checklist items</span> }</div></div>
                    <div class="flex flex-wrap items-center gap-4"><a class="text-sm font-semibold text-brand-600" href="/tasks/@task.Id">View task →</a><form method="post" action="/tasks/@task.Id/@(task.IsArchived ? "restore" : task.CompletedAt is not null ? "reopen" : "complete")">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@task.Version" /><input type="hidden" name="BoardVersion" value="@boardVersion" /><button class="rounded-xl border border-slate-200 px-4 py-2 text-xs text-slate-600" type="submit">@(task.IsArchived ? "Restore" : task.CompletedAt is not null ? "Reopen" : "Mark complete")</button></form></div>
                </article>
            }
        </div>
        @if (Model.Total > 0)
        {
            <nav class="flex items-center justify-between gap-3 text-sm text-brand-600" aria-label="Task pages">@if (Model.Page > 1) { <a href="/tasks?boardId=@Model.BoardId&search=@Uri.EscapeDataString(Model.Search)&priority=@Model.Priority&state=@Model.State&assignment=@Model.Assignment&due=@Model.Due&sort=@Model.Sort&page=@(Model.Page - 1)">← Previous</a> }<span class="text-slate-500">Page @Model.Page of @Model.Pages</span>@if (Model.Page < Model.Pages) { <a href="/tasks?boardId=@Model.BoardId&search=@Uri.EscapeDataString(Model.Search)&priority=@Model.Priority&state=@Model.State&assignment=@Model.Assignment&due=@Model.Due&sort=@Model.Sort&page=@(Model.Page + 1)">Next →</a> }</nav>
        }
    }
</div>
