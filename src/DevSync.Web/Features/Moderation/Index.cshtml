@model DevSync.Web.Features.Moderation.QueueModel
@{ViewData["Title"]="Moderation";}
<div class="mx-auto max-w-6xl space-y-6"><header><h1 class="text-3xl font-semibold">Review and protect the community</h1><p class="mt-3 text-sm text-slate-500">Review publisher evidence and public-content reports. Decisions require a recorded reason.</p></header><nav class="flex gap-5 text-sm text-brand-600"><a href="/moderation">Pending</a><a href="/moderation?status=resolved">Reviewed</a></nav>
<section class="space-y-4"><h2 class="text-xl font-semibold">Publisher verification</h2>@if(Model.Verifications.Length==0){<p class="text-sm text-slate-500">No requests in this view.</p>}@foreach(var v in Model.Verifications){<a href="/moderation/verification/@v.Id" class="block rounded-xl border border-slate-200 bg-white p-5"><p class="text-sm font-medium text-brand-600">@v.Status</p><p class="mt-3 break-all text-sm">@v.EvidenceUrl</p><p class="mt-3 text-xs text-slate-500">@v.SubmittedAt.ToString("MMM d, yyyy HH:mm") UTC</p></a>}</section>
<section class="space-y-4"><h2 class="text-xl font-semibold">Content reports</h2>@if(Model.Reports.Length==0){<p class="text-sm text-slate-500">No reports in this view.</p>}@foreach(var r in Model.Reports){<a href="/moderation/reports/@r.Id" class="block rounded-xl border border-slate-200 bg-white p-5"><p class="text-sm font-medium text-brand-600">@r.Kind · @r.Category · @r.Status</p><p class="mt-3 break-words text-sm">@r.Excerpt</p><p class="mt-3 text-xs text-slate-500">@r.Date.ToString("MMM d, yyyy HH:mm") UTC</p></a>}</section>
<div class="flex gap-5 text-sm text-brand-600"><span class="text-slate-500">Page @Model.Page of @Model.Pages</span>@if(Model.Page>1){<a href="/moderation?status=@Model.Status&page=@(Model.Page-1)">Previous</a>}@if(Model.Page<Model.Pages){<a href="/moderation?status=@Model.Status&page=@(Model.Page+1)">Next</a>}</div></div>
