@model DevSync.Web.Features.Teams.Manage.ViewModel
@{ ViewData["Title"] = "Team members"; var manager = DevSync.Web.Features.Teams.Access.Manage(Model.Role); var actor = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<div class="mx-auto max-w-5xl space-y-6">
    <header><a href="/teams/@Model.Id" class="text-sm text-brand-600">← @Model.Name</a><h1 class="mt-4 text-3xl font-semibold">Members and invitations</h1><p class="mt-3 text-sm text-slate-500">Owners manage admins. Admins manage members and viewers. Viewers can read; members can create and edit team content.</p></header>
    @if(TempData["Success"] is string success) { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    @if(manager && TempData["InvitationLink"] is string link) { <div class="rounded-xl bg-brand-50 p-5"><p class="text-sm text-brand-700">Invitation created. This link is shown once; copy it and share it with the invited person. It expires in seven days and requires their verified email.</p><a id="invitation-link" href="@link" class="mt-3 block break-all text-sm text-brand-600" rel="noreferrer">@($"{Context.Request.Scheme}://{Context.Request.Host}{link}")</a></div> }
    @if(manager) { <form method="post" action="/teams/@Model.Id/invitations" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><h2 class="font-semibold">Invite a teammate</h2><div><label for="Email" class="form-label">Email</label><input id="Email" name="Email" type="email" required maxlength="256" class="form-input" /></div><div><label for="Role" class="form-label">Role</label><select id="Role" name="Role" class="form-input"><option value="member">Member</option><option value="viewer">Viewer</option></select></div><button class="form-button">Invite teammate</button><p class="text-xs text-slate-500">An invitation email is prepared using the configured delivery service. A new invitation replaces earlier links for the same email.</p></form> }
    <section class="space-y-4"><h2 class="text-xl font-semibold">Members (@Model.Members.Length)</h2>@foreach(var member in Model.Members) {
        <div class="rounded-2xl border border-slate-200 bg-white p-5"><div class="flex flex-wrap justify-between gap-3"><p class="font-medium break-words">@member.Name</p><span class="text-sm text-brand-600">@member.Role</span></div>
            @if(manager && member.Role != "owner" && member.Id.ToString() != actor && (Model.Role == "owner" || member.Role != "admin")) {
                <form action="/teams/@Model.Id/members" method="post" class="mt-4 flex flex-wrap gap-3">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="MemberId" value="@member.Id" /><label for="role-@member.Id" class="sr-only">Role for @member.Name</label><select id="role-@member.Id" name="Role" class="form-input w-auto">@foreach(var r in Model.Role == "owner" ? new[]{"admin","member","viewer"} : new[]{"member","viewer"}) { <option value="@r" selected="@(r == member.Role)">@r</option> }</select><button name="Operation" value="role" class="rounded-xl border border-slate-200 px-4 py-3 text-sm">Change role</button><button name="Operation" value="remove" class="rounded-xl border border-slate-200 px-4 py-3 text-sm">Remove member</button>@if(Model.Role == "owner" && member.Role != "viewer") { <button name="Operation" value="transfer" class="rounded-xl border border-slate-200 px-4 py-3 text-sm">Transfer ownership</button> }</form>
            }
        </div>
    }</section>
    @if(manager && Model.Invitations.Length > 0) { <section class="space-y-4"><h2 class="text-xl font-semibold">Pending invitations</h2>@foreach(var invite in Model.Invitations) { <div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="break-all font-medium">@invite.Email</p><p class="mt-2 text-sm text-slate-500">@invite.Role · Expires @invite.ExpiresAt.ToString("MMM d, yyyy HH:mm") UTC</p><form action="/teams/@Model.Id/invitations/@invite.Id/revoke" method="post" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><button class="text-sm text-brand-600">Revoke invitation</button></form></div> }</section> }
    <section class="rounded-2xl border border-slate-200 bg-white p-6"><h2 class="font-semibold">Recent activity</h2><ul class="mt-4 space-y-3">@foreach(var activity in Model.Activities) { <li class="text-sm text-slate-600">@activity.Description <span class="block text-xs text-slate-600">@activity.At.ToString("MMM d, yyyy HH:mm") UTC</span></li> }</ul></section>
    @if(Model.Role != "owner") { <form action="/teams/@Model.Id/members" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><button name="Operation" value="leave" class="rounded-xl border border-slate-200 px-5 py-3 text-sm">Leave team</button></form> } else { <p class="text-xs text-slate-500">Transfer ownership to another member before leaving.</p> }
</div>
