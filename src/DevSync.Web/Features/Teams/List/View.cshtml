@model DevSync.Web.Features.Teams.List.TeamRow[]
@{ ViewData["Title"] = "Teams"; }
<div class="mx-auto max-w-6xl space-y-7">
    <header><p class="text-xs font-semibold uppercase tracking-widest text-brand-600">Build together</p><h1 class="mt-3 text-3xl font-semibold">Your teams</h1><p class="mt-3 text-sm leading-7 text-slate-500">Share knowledge and plan work in a private team workspace.</p></header>
    @if (TempData["Success"] is string success) { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    <form action="/teams/create" method="post" class="rounded-2xl border border-slate-200 bg-white p-6">
        @Html.AntiForgeryToken()<label for="Name" class="form-label">Create a team</label><div class="flex flex-wrap gap-3"><input id="Name" name="Name" required maxlength="80" class="form-input flex-1 min-w-0" placeholder="Your team name" /><button class="form-button">Create team</button></div>
    </form>
    @if (Model.Length == 0) { <div class="rounded-2xl border border-dashed border-slate-300 p-8 text-slate-500">No teams yet. Create one or accept an invitation using the email on your account.</div> }
    <div class="grid gap-5 md:grid-cols-2">
        @foreach (var team in Model) { <a href="/teams/@team.Id" class="rounded-2xl border border-slate-200 bg-white p-6 hover:border-brand-300"><p class="text-xs uppercase text-brand-600">@team.Role</p><h2 class="mt-3 text-xl font-semibold break-words">@team.Name</h2><p class="mt-4 text-sm text-slate-500">@team.Members members · @team.Items active items</p><span class="mt-5 inline-block text-sm text-brand-600">Open workspace →</span></a> }
    </div>
</div>
