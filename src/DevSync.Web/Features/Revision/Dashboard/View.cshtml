@model DevSync.Web.Features.Revision.Dashboard.ViewModel
@{ ViewData["Title"] = "Revision"; }
<div class="mx-auto max-w-6xl space-y-8">
    <header class="flex flex-wrap items-end justify-between gap-5"><div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-600">A little practice every day</p><h1 class="text-4xl font-semibold tracking-tight">Revision workspace</h1><p class="mt-3 text-sm text-slate-500">Turn your private notes into questions worth remembering.</p></div><a href="/notes" class="form-button">Add cards from your notes →</a></header>
    @if (TempData["Success"] is string success) { <p class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@success</p> }
    <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6"><p class="text-sm text-brand-700">Due now</p><p class="mt-2 text-3xl font-semibold" data-revision-count="due">@Model.Due</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-sm text-slate-500">Scheduled later</p><p class="mt-2 text-3xl font-semibold" data-revision-count="scheduled">@Model.Scheduled</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-sm text-slate-500">Reviews today · UTC</p><p class="mt-2 text-3xl font-semibold" data-revision-count="today">@Model.ReviewedToday</p></div>
    </div>
    @if (Model.Suspended > 0) { <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">@Model.Suspended cards are paused because their source notes are archived. Restore a note to resume its cards; review history is kept.</p> }
    <section aria-labelledby="cards-heading" class="space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4"><h2 id="cards-heading" class="text-2xl font-semibold">@(Model.View == "scheduled" ? "Coming up" : "Your review queue")</h2><nav class="flex gap-2 text-sm" aria-label="Revision card filter"><a href="/revision" aria-current="@(Model.View == "due" ? "page" : null)" class="rounded-lg px-4 py-2 @(Model.View == "due" ? "bg-brand-100 font-semibold text-brand-700" : "bg-white text-slate-500")">Due now</a><a href="/revision?view=scheduled" aria-current="@(Model.View == "scheduled" ? "page" : null)" class="rounded-lg px-4 py-2 @(Model.View == "scheduled" ? "bg-brand-100 font-semibold text-brand-700" : "bg-white text-slate-500")">Scheduled</a></nav></div>
        @if (Model.Cards.Count == 0)
        { <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center"><h3 class="text-xl font-semibold">@(Model.View == "scheduled" ? "No reviews scheduled yet" : Model.Scheduled > 0 ? "You're caught up for now" : "Make room for your first card")</h3><p class="mt-3 text-sm leading-7 text-slate-500">@(Model.View == "scheduled" ? "Complete a due review to see its next date here." : Model.Scheduled > 0 ? "Your next cards are waiting in Scheduled. Return when they're due." : "Open a note and create a question and answer. Your cards are visible only to you.")</p><a href="/notes" class="mt-5 inline-block text-sm font-semibold text-brand-600">Go to your notes →</a></div> }
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var card in Model.Cards)
            { <article class="flex flex-col rounded-2xl border border-slate-200/70 bg-white p-6"><a href="/notes/@card.NoteId" class="truncate text-xs font-medium text-brand-600">@card.NoteTitle</a><h3 class="mt-3 whitespace-pre-wrap break-words text-lg font-semibold leading-relaxed">@card.Prompt</h3><p class="mb-5 mt-4 text-xs text-slate-500">@(Model.View == "due" ? "Due" : "Next review") @card.DueAt.ToString("MMM d, yyyy HH:mm 'UTC'") · @card.ReviewCount reviews</p><a class="mt-auto text-sm font-semibold text-brand-600" href="/revision/@card.Id">@(Model.View == "due" ? "Review card →" : "View card →")</a></article> }
        </div>
        @if (Model.Pages > 1) { <nav class="flex justify-between text-sm text-brand-600" aria-label="Revision card pages">@if (Model.Page > 1) { <a href="/revision?view=@Model.View&page=@(Model.Page - 1)&historyPage=@Model.HistoryPage">← Previous</a> }<span class="text-slate-500">Page @Model.Page of @Model.Pages</span>@if (Model.Page < Model.Pages) { <a href="/revision?view=@Model.View&page=@(Model.Page + 1)&historyPage=@Model.HistoryPage">Next →</a> }</nav> }
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8" aria-labelledby="recent-reviews"><div class="flex flex-wrap items-center justify-between gap-3"><h2 id="recent-reviews" class="text-xl font-semibold">Recent reviews</h2><p class="text-xs text-slate-500">@Model.TotalReviews reviews in total · UTC</p></div>
        @if (Model.History.Count == 0) { <p class="mt-5 text-sm text-slate-500">Each review you complete will appear here.</p> }
        <ol class="mt-4 divide-y divide-slate-100">
            @foreach (var review in Model.History)
            { <li class="flex flex-wrap justify-between gap-4 py-4"><div class="min-w-0 flex-1">@if (review.IsArchived) { <p class="break-words text-sm font-medium text-slate-700">@review.Prompt <span class="text-xs text-slate-600">· Archived note</span></p> } else { <a href="/revision/@review.CardId" class="break-words text-sm font-medium text-brand-600">@review.Prompt</a> }<p class="mt-1 text-xs text-slate-500">@review.ReviewedAt.ToString("MMM d, yyyy HH:mm 'UTC'")</p></div><span class="text-sm font-semibold text-brand-700">@review.Grade</span></li> }
        </ol>
        @if (Model.HistoryPages > 1) { <nav class="mt-5 flex justify-between text-sm text-brand-600" aria-label="Recent review pages">@if (Model.HistoryPage > 1) { <a href="/revision?view=@Model.View&page=@Model.Page&historyPage=@(Model.HistoryPage - 1)">← Previous</a> }<span class="text-slate-500">Page @Model.HistoryPage of @Model.HistoryPages</span>@if (Model.HistoryPage < Model.HistoryPages) { <a href="/revision?view=@Model.View&page=@Model.Page&historyPage=@(Model.HistoryPage + 1)">Next →</a> }</nav> }
    </section>
    <p class="text-xs leading-6 text-slate-500">Again returns a card in 10 minutes and resets its interval. Hard, Good, and Easy begin at 1, 3, and 7 days; later intervals grow by 1.2×, 2×, and 3×, up to 365 days. Your cards and history stay private.</p>
</div>
