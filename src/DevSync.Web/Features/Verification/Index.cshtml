@model DevSync.Web.Features.Verification.ViewModel
@{ViewData["Title"]="Publisher verification";}
<div class="mx-auto max-w-3xl space-y-6"><header><a href="/account/settings" class="text-sm text-brand-600">← Settings</a><h1 class="mt-4 text-3xl font-semibold">Publisher verification</h1><p class="mt-3 text-sm leading-7 text-slate-500">Request a reviewed publisher badge. Your ability to draft and publish articles stays the same.</p></header>
@if(TempData["Success"] is string success){<p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p>}
<partial name="_ValidationSummary"/>
@if(Model.CanSubmit){<form method="post" action="/account/verification" class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6">@Html.AntiForgeryToken()<input name="Version" type="hidden" value="@Model.Command.Version"/><div><label for="EvidenceUrl" class="form-label">Public portfolio or professional-profile URL</label><input id="EvidenceUrl" name="EvidenceUrl" value="@Model.Command.EvidenceUrl" type="url" required maxlength="2048" class="form-input" placeholder="https://example.com/portfolio"/><p class="mt-2 text-xs leading-6 text-slate-500">Use a public HTTPS link. Evidence stays visible only to you and authorized reviewers. We do not fetch the link or accept file uploads.</p></div><div><label for="Statement" class="form-label">Your publishing experience</label><textarea id="Statement" name="Statement" class="form-input" required maxlength="2000" rows="6">@Model.Command.Statement</textarea></div><button class="form-button">Request verification</button></form>}
else{<p class="rounded-xl bg-brand-50 p-5 text-sm text-brand-700">You have a pending request or an approved publisher badge.</p>}
<section class="space-y-4"><h2 class="text-xl font-semibold">Request history</h2>@if(Model.Requests.Length==0){<p class="text-sm text-slate-500">No requests yet.</p>}@foreach(var request in Model.Requests){<article class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-sm font-semibold text-brand-600">@request.Status</p><p class="mt-3 break-all text-xs text-slate-500">@request.EvidenceUrl</p><p class="mt-3 whitespace-pre-wrap break-words text-sm leading-7">@request.Statement</p>@if(request.Reason.Length>0){<p class="mt-4 text-sm text-slate-600">Reviewer decision: @request.Reason</p>}<p class="mt-4 text-xs text-slate-600">@request.SubmittedAt.ToString("MMM d, yyyy HH:mm") UTC</p></article>}</section></div>
