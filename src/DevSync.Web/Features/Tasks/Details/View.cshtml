@model DevSync.Web.Features.Tasks.Details.ViewModel
@{
    ViewData["Title"] = Model.Title;
    var paused = !ViewData.ModelState.IsValid;
}
<div class="mx-auto max-w-5xl space-y-6">
    <a class="text-sm text-brand-600" href="/tasks/board?boardId=@Model.BoardId">← @Model.BoardName</a>
    @if (TempData["Error"] is string error) { <p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">@error</p> }
    @if (TempData["Success"] is string success) { <p class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    <partial name="_ValidationSummary" />
    @if (paused) { <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-brand-100 bg-brand-50 p-4"><p class="text-sm text-brand-700">Reload the current task before making another change.</p><a class="text-sm font-semibold text-brand-600" href="/tasks/@Model.Id">Reload latest task →</a></div> }
    <article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8"><header class="border-b border-slate-100 pb-6"><div class="flex flex-wrap items-center gap-2 text-xs"><span class="rounded-full bg-brand-50 px-3 py-1.5 text-brand-700">@Model.ColumnName</span><span class="rounded-full px-3 py-1.5 capitalize @(Model.Priority == "urgent" ? "bg-red-50 text-red-700" : Model.Priority == "high" ? "bg-amber-50 text-amber-700" : "bg-slate-100 text-slate-600")">@Model.Priority priority</span>@if (Model.IsArchived) { <span class="rounded-full bg-slate-100 px-3 py-1.5 text-slate-500">Archived</span> }</div><h1 class="mt-4 break-words text-3xl font-semibold leading-tight tracking-tight">@Model.Title</h1><div class="mt-4 flex flex-wrap gap-4 text-xs text-slate-500"><span>@(Model.AssignedToMe ? "Assigned to me" : "Unassigned")</span>@if (Model.DueDate is not null) { <span>Due <time datetime="@Model.DueDate.Value.ToString("yyyy-MM-dd")">@Model.DueDate.Value.ToString("MMM d, yyyy")</time></span> }<span>Updated <time datetime="@Model.UpdatedAt.ToString("O")">@Model.UpdatedAt.ToString("MMM d, yyyy HH:mm 'UTC'")</time></span></div></header>
        <p class="mt-6 whitespace-pre-wrap break-words text-sm leading-8 text-slate-600">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description added." : Model.Description)</p>
        <div class="mt-6 flex flex-wrap gap-3 border-t border-slate-100 pt-6">
            @if (!Model.IsArchived)
            {
                <a class="form-button" href="/tasks/@Model.Id/edit">Edit task</a><form method="post" action="/tasks/@Model.Id/@(Model.CompletedAt is null ? "complete" : "reopen")">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="BoardVersion" value="@Model.BoardVersion" /><button class="rounded-xl border border-brand-100 px-4 py-3 text-sm font-semibold text-brand-700" type="submit" disabled="@paused">@(Model.CompletedAt is null ? "Mark complete" : "Reopen task")</button></form>
            }
            <form method="post" action="/tasks/@Model.Id/@(Model.IsArchived ? "restore" : "archive")" class="sm:ml-auto">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="BoardVersion" value="@Model.BoardVersion" /><button class="rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-500" type="submit" disabled="@paused">@(Model.IsArchived ? "Restore task" : "Archive task")</button></form>
        </div>
    </article>
    <div class="grid items-start gap-6 lg:grid-cols-[1fr_20rem]">
        <section class="rounded-2xl border border-slate-200 bg-white p-6" aria-labelledby="details-checklist-title"><div class="flex items-center justify-between gap-3"><h2 id="details-checklist-title" class="text-lg font-semibold">Checklist</h2><span class="text-xs text-slate-500">@Model.Checklist.Count(item => item.IsCompleted)/@Model.Checklist.Count</span></div>@if (Model.Checklist.Count == 0) { <p class="mt-4 text-sm leading-7 text-slate-500">No checklist yet. Edit the task to add small, actionable steps.</p> }@foreach (var item in Model.Checklist) { <form method="post" action="/tasks/@Model.Id/checklist?operation=toggle&itemId=@item.Id" class="mt-4 flex items-start gap-3 border-t border-slate-100 pt-4">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="BoardVersion" value="@Model.BoardVersion" /><input type="hidden" name="IsCompleted" value="@((!item.IsCompleted).ToString().ToLowerInvariant())" /><button type="submit" aria-pressed="@item.IsCompleted.ToString().ToLowerInvariant()" aria-label="@(item.IsCompleted ? "Mark open: " : "Mark completed: ")@item.Text" disabled="@(paused || Model.IsArchived)" class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded border @(item.IsCompleted ? "border-brand-600 bg-brand-600 text-white" : "border-slate-300")">@(item.IsCompleted ? "✓" : "")</button><p class="break-words text-sm leading-7 @(item.IsCompleted ? "text-slate-600 line-through" : "text-slate-600")">@item.Text</p></form> }</section>
        <aside class="space-y-5">
            @if (!Model.IsArchived)
            {
                <form method="post" action="/tasks/@Model.Id/move" class="rounded-2xl border border-slate-200 bg-white p-5">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="BoardVersion" value="@Model.BoardVersion" /><label for="details-task-column" class="form-label">Move to column</label><select id="details-task-column" name="ColumnId" class="form-input" disabled="@paused">@foreach (var column in Model.Columns) { <option value="@column.Id" selected="@(column.Id == Model.ColumnId)">@column.Name</option> }</select><button type="submit" class="mt-3 w-full rounded-xl border border-brand-100 px-4 py-3 text-sm font-semibold text-brand-700" disabled="@paused">Move task</button></form>
            }
            <section class="rounded-2xl border border-slate-200 bg-white p-5" aria-labelledby="task-links-title"><h2 id="task-links-title" class="text-sm font-semibold">Connected learning</h2>@if (Model.Note is not null) { <a class="mt-4 block break-words text-sm leading-6 text-brand-600" href="@Model.Note.Url">Note: @Model.Note.Title →</a> }@if (Model.Article is not null) { <a class="mt-4 block break-words text-sm leading-6 text-brand-600" href="@Model.Article.Url">@(Model.Article.IsDraft ? "Your draft: " : "Article: ")@Model.Article.Title →</a> }@if (Model.Note is null && Model.Article is null) { <p class="mt-3 text-xs leading-6 text-slate-500">Add a note or article link while editing this task.</p> }</section>
        </aside>
    </div>
    <section id="task-activity" class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6" aria-labelledby="task-activity-title"><h2 id="task-activity-title" class="text-lg font-semibold">Activity <span class="text-sm font-normal text-slate-600">(@Model.ActivityTotal)</span></h2>@if (Model.Activities.Count == 0) { <p class="mt-4 text-sm text-slate-500">Changes to this task will appear here.</p> }<ol class="mt-4 space-y-4">@foreach (var activity in Model.Activities) { <li class="border-t border-slate-100 pt-4"><p class="text-sm leading-7 text-slate-600">@activity.Description</p><time class="mt-1 block text-xs text-slate-600" datetime="@activity.CreatedAt.ToString("O")">@activity.CreatedAt.ToString("MMM d, yyyy HH:mm 'UTC'")</time></li> }</ol>@if (Model.ActivityPages > 1) { <nav class="mt-5 flex justify-between gap-3 text-sm text-brand-600" aria-label="Activity pages">@if (Model.ActivityPage > 1) { <a href="/tasks/@Model.Id?activityPage=@(Model.ActivityPage - 1)#task-activity">← Newer activity</a> }<span class="text-slate-500">Page @Model.ActivityPage of @Model.ActivityPages</span>@if (Model.ActivityPage < Model.ActivityPages) { <a href="/tasks/@Model.Id?activityPage=@(Model.ActivityPage + 1)#task-activity">Older activity →</a> }</nav> }</section>
</div>
