@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DevSync.Web.Features.Tasks.Edit.Command
@{
    ViewData["Title"] = Model.IsNew ? "New task" : "Edit task";
    var action = Model.IsNew ? "/tasks/create" : $"/tasks/{Model.Id}/save";
    var checklistAction = Model.IsNew ? "/tasks/create" : $"/tasks/{Model.Id}/checklist";
    var paused = ViewData["SavePaused"] as bool? == true;
}
<div class="mx-auto max-w-4xl space-y-6">
    <header><a class="text-sm text-brand-600" href="@(Model.IsNew ? "/tasks/board?boardId=" + Model.BoardId : "/tasks/" + Model.Id)">← @(Model.IsNew ? "Back to board" : "Back to task")</a><h1 class="mt-4 text-3xl font-semibold tracking-tight">@(Model.IsNew ? "Start with the next step" : "Keep the plan clear")</h1><p class="mt-3 text-sm leading-7 text-slate-500">@Model.BoardName · Private task. Add a checklist and connect the notes or articles you need.</p></header>
    @if (TempData["Error"] is string error) { <p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">@error</p> }
    @if (TempData["Success"] is string success) { <p class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    @if (paused) { <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-brand-100 bg-brand-50 p-4"><p class="text-sm text-brand-700">Copy your edits before loading the current task version.</p><a class="text-sm font-semibold text-brand-600" href="@(Model.IsNew ? "/tasks/create?boardId=" + Model.BoardId : "/tasks/" + Model.Id + "/edit")">Reload editor →</a></div> }
    @if (Model.IsNew && Model.Boards.Count > 1)
    {
        <form method="get" action="/tasks/create" class="flex flex-wrap items-end gap-3 rounded-2xl border border-slate-200 bg-white p-5"><div class="min-w-48 flex-1"><label for="new-task-board" class="form-label">Choose a board before entering your task</label><select id="new-task-board" name="boardId" class="form-input">@foreach (var board in Model.Boards) { <option value="@board.Id" selected="@(board.Id == Model.BoardId)">@board.Name</option> }</select></div><button type="submit" class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold">Use board</button></form>
    }
    @if (Model.IsArchived) { <p class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm text-brand-700">This task is archived. Restore it from the task page before editing.</p> }
    <form id="task-editor" method="post" action="@action" data-checklist="@checklistAction" data-archived="@Model.IsArchived.ToString().ToLowerInvariant()" data-paused="@paused.ToString().ToLowerInvariant()" data-unsaved="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())" class="space-y-6">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="BoardId" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="BoardVersion" type="hidden" /><partial name="_ValidationSummary" />
        <fieldset disabled="@Model.IsArchived" class="space-y-6">
            <div class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
                <div><label asp-for="Title" class="form-label">Task title</label><input asp-for="Title" class="form-input text-lg" required maxlength="160" placeholder="What will you do next?" /><span asp-validation-for="Title" class="form-error"></span></div>
                <div><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-input leading-7" rows="5" maxlength="4000" placeholder="Capture the context, outcome, or acceptance criteria…"></textarea><span asp-validation-for="Description" class="form-error"></span></div>
                <div class="grid gap-5 sm:grid-cols-2"><div><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-input"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option><option value="urgent">Urgent</option></select><span asp-validation-for="Priority" class="form-error"></span></div><div><label asp-for="DueDate" class="form-label">Due date (optional)</label><input asp-for="DueDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-input" /><span asp-validation-for="DueDate" class="form-error"></span></div></div>
                <div class="grid gap-5 sm:grid-cols-2"><div><label asp-for="ColumnId" class="form-label">Column</label><select asp-for="ColumnId" class="form-input">@foreach (var column in Model.Columns) { <option value="@column.Id">@column.Name</option> }</select><span asp-validation-for="ColumnId" class="form-error"></span></div><div class="flex items-center gap-3 self-end rounded-xl border border-slate-200 px-4 py-3"><input asp-for="AssignedToMe" class="size-4 accent-brand-600" /><label asp-for="AssignedToMe" class="text-sm text-slate-600">Assign this task to me</label></div></div>
            </div>
            <div class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"><h2 class="text-lg font-semibold">Connect your learning</h2><div><label asp-for="LinkedNoteId" class="form-label">Study note (optional)</label><select asp-for="LinkedNoteId" class="form-input"><option value="">No linked note</option>@foreach (var note in Model.Notes) { <option value="@note.Id">@note.Title</option> }</select><span asp-validation-for="LinkedNoteId" class="form-error"></span></div><div><label asp-for="LinkedPostId" class="form-label">Article (optional)</label><select asp-for="LinkedPostId" class="form-input"><option value="">No linked article</option>@foreach (var article in Model.Articles) { <option value="@article.Id">@article.Title @(article.Url.Length == 0 ? "" : article.IsDraft ? "· your draft" : "· published")</option> }</select><span asp-validation-for="LinkedPostId" class="form-error"></span><p class="mt-2 text-xs leading-6 text-slate-500">Your own working drafts and published articles are available. Links to private work stay private.</p></div></div>
            <section class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8" aria-labelledby="task-checklist-title"><div class="flex flex-wrap items-center justify-between gap-3"><h2 id="task-checklist-title" class="text-lg font-semibold">Checklist</h2><span class="text-xs text-slate-500">Up to 30 items · 300 characters each</span></div><div id="task-checklist" class="space-y-3">@for (var i = 0; i < Model.Checklist.Count; i++) { @await Html.PartialAsync("_ChecklistItem.cshtml", Model, new ViewDataDictionary(ViewData) { ["ChecklistIndex"] = i }) }</div><p id="task-checklist-empty" hidden="@(Model.Checklist.Count != 0)" class="rounded-xl border border-dashed border-slate-200 p-5 text-sm text-slate-500">Break the task into smaller steps with a checklist.</p><button id="task-add-checklist" type="submit" formaction="@(checklistAction)?operation=add" data-checklist-action="add" class="rounded-xl border border-brand-100 px-4 py-3 text-sm font-semibold text-brand-700">Add checklist item ＋</button><noscript><p class="text-xs leading-6 text-slate-500">Checklist controls save your current fields before adding, moving, or removing an item.</p></noscript></section>
            <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5"><p id="task-editor-status" class="text-xs leading-6 text-slate-500" role="status" aria-live="polite">Changes are saved when you submit this form.</p><button type="submit" class="form-button">@(Model.IsNew ? "Create task" : "Save task")</button></div>
        </fieldset>
    </form>
    <template id="task-checklist-template">@await Html.PartialAsync("_ChecklistItem.cshtml", Model, new ViewDataDictionary(ViewData) { ["ChecklistIndex"] = -1 })</template>
</div>
@section Scripts { <script src="~/js/task-board.js" asp-append-version="true" defer></script> }
