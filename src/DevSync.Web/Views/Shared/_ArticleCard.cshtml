@model DevSync.Web.Features.Blogs.Explore.ArticleCard
<article class="flex flex-col rounded-2xl border border-slate-200/70 bg-white p-6">
    <div class="mb-5 flex flex-wrap gap-2">
        @foreach (var tag in Model.Tags) { <a href="/blogs?tag=@Uri.EscapeDataString(tag)" class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">@tag</a> }
    </div>
    <h2 class="text-xl font-semibold leading-7 tracking-tight"><a class="hover:text-brand-600" href="/blogs/@Model.Slug">@Model.Title</a></h2>
    <p class="mt-3 flex-1 text-sm leading-7 text-slate-500">@Model.Summary</p>
    <div class="mt-6 flex items-center justify-between gap-3 border-t border-slate-100 pt-4 text-xs text-slate-500"><span>@Model.Author</span><time datetime="@Model.Date.ToString("O")">@Model.Date.ToString("MMM d, yyyy")</time></div>
</article>
