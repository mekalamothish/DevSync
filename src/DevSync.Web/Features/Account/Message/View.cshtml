@model DevSync.Web.Features.Account.Message.ViewModel
@{ ViewData["Title"] = Model.Heading; }
<div class="mb-6 flex size-12 items-center justify-center rounded-2xl bg-brand-50 text-xl text-brand-600" aria-hidden="true">@(Model.IsError ? "!" : "✓")</div>
<h1 class="text-3xl font-semibold tracking-tight">@Model.Heading</h1>
<p class="mt-4 text-sm leading-7 text-slate-500">@Model.Description</p>
<a href="/account/sign-in" class="form-button mt-7 w-full">Back to sign in</a>
<a href="/account/resend-verification" class="mt-5 block text-center text-sm text-brand-600">Resend verification email</a>
