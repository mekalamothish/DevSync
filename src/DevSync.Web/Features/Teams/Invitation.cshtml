@model DevSync.Web.Features.Teams.Invitations.ViewModel
@{ ViewData["Title"] = "Team invitation"; }
<div class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-8"><p class="text-xs uppercase text-brand-600">You're invited</p><h1 class="mt-4 break-words text-3xl font-semibold">Join @Model.TeamName</h1><p class="mt-4 text-sm leading-7 text-slate-500">Join as @Model.Role. Team content will be available after you accept. Your personal content stays private unless you explicitly share a copy.</p><p class="mt-3 text-xs text-slate-500">Expires @Model.ExpiresAt.ToString("MMM d, yyyy HH:mm") UTC</p><form action="/teams/invitations/accept" method="post" class="mt-6">@Html.AntiForgeryToken()<input type="hidden" name="Token" value="@Model.Token" /><button class="form-button">Accept invitation</button></form></div>
