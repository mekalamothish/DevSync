@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model DevSync.Web.Features.Teams.Workspace.ItemModel
@{ ViewData["Title"] = Model.Command.Title; var write = DevSync.Web.Features.Teams.Access.Write(Model.Team.Role); var paused = ViewData["SavePaused"] as bool? == true; }
<div class="mx-auto max-w-4xl space-y-6">
    <header><a href="/teams/@Model.Team.Id" class="text-sm text-brand-600">← @Model.Team.Name</a><h1 class="mt-4 text-3xl font-semibold break-words">@Model.Command.Title</h1><p class="mt-3 text-sm text-slate-500">Team @Model.Command.Kind · @(Model.IsArchived ? "Archived" : "Active") · Saved @Model.UpdatedAt.ToString("MMM d, yyyy HH:mm") UTC</p></header>
    @if(TempData["Success"] is string success) { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    <div class="article-content break-words rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">@Html.Raw(Model.Command.ContentFormat=="richtext" ? DevSync.Web.Common.Content.RichTextDocument.Render(Model.Command.Body,Configuration["Account:PublicBaseUrl"]) : DevSync.Web.Features.Blogs.Common.ArticleRenderer.Render(Model.Command.Body ?? "", Configuration["Account:PublicBaseUrl"]))</div>
    @if(Model.Command.Kind == "task") { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700">@Model.Command.State · @Model.Command.Priority · @(Model.Team.Members.SingleOrDefault(m => m.Id == Model.Command.AssignedUserId)?.Name ?? "Unassigned") · @(Model.Command.DueDate?.ToString("MMM d, yyyy") ?? "No deadline")</p> }
    @if(write && !Model.IsArchived) {
        <form action="/teams/@Model.Team.Id/items/@Model.Id/save" method="post" class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
            @Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Command.Version" /><input type="hidden" name="Kind" value="@Model.Command.Kind" /><input type="hidden" name="ContentFormat" value="@Model.Command.ContentFormat" /><partial name="_ValidationSummary" />
            @if(paused) { <p class="text-sm text-red-700">Saving is paused. Copy your edits before reloading this page.</p> }
            <div><label for="Title" class="form-label">Title</label><input id="Title" name="Title" value="@Model.Command.Title" class="form-input" required maxlength="160" /></div>
            <a href="/teams/@Model.Team.Id/images" target="_blank" rel="noopener" class="text-sm text-brand-600">Open team image library ↗</a>
            @if(Model.Command.ContentFormat=="richtext") { @await Html.PartialAsync("_RichTextEditor",new DevSync.Web.Common.Content.RichTextEditorModel("Body","Body",Model.Command.Body,MaxLength:50000)) }
            else { <div><label for="Body" class="form-label">Content (Markdown)</label><textarea id="Body" name="Body" class="form-input font-mono" maxlength="50000" rows="12">@Model.Command.Body</textarea></div> }
            @if(Model.Command.Kind == "task") {
                <div class="grid gap-4 sm:grid-cols-2">
                    <div><label for="State" class="form-label">Status</label><select id="State" name="State" class="form-input">@foreach(var state in new[]{"todo","in-progress","done"}) { <option value="@state" selected="@(Model.Command.State == state)">@state</option> }</select></div>
                    <div><label for="Priority" class="form-label">Priority</label><select id="Priority" name="Priority" class="form-input">@foreach(var priority in new[]{"low","medium","high","urgent"}) { <option value="@priority" selected="@(Model.Command.Priority == priority)">@priority</option> }</select></div>
                    <div><label for="AssignedUserId" class="form-label">Assigned to</label><select id="AssignedUserId" name="AssignedUserId" class="form-input"><option value="">Unassigned</option>@foreach(var member in Model.Team.Members.Where(m => m.Role != "viewer")) { <option value="@member.Id" selected="@(Model.Command.AssignedUserId == member.Id)">@member.Name</option> }</select></div>
                    <div><label for="DueDate" class="form-label">Due date</label><input id="DueDate" name="DueDate" type="date" value="@(Model.Command.DueDate?.ToString("yyyy-MM-dd"))" class="form-input" /></div>
                </div>
            }
            <p class="text-xs text-slate-500">Save manually. A stale version is rejected to protect another member's changes.</p><button class="form-button" disabled="@paused">Save team content</button>
        </form>
    }
    @if(write && !paused) { <form action="/teams/@Model.Team.Id/items/@Model.Id/archive" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Command.Version" /><input type="hidden" name="Archived" value="@((!Model.IsArchived).ToString().ToLowerInvariant())" /><button class="rounded-xl border border-slate-200 px-5 py-3 text-sm">@(Model.IsArchived ? "Restore item" : "Archive item")</button></form> }
</div>

@section Scripts { <script type="module" src="~/vendor/code/rich-text.js" asp-append-version="true"></script> }
