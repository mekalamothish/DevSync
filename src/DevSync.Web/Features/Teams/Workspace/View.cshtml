@model DevSync.Web.Features.Teams.Workspace.ViewModel
@{ ViewData["Title"] = Model.Team.Name; var write = DevSync.Web.Features.Teams.Access.Write(Model.Team.Role); var draft = ViewData["CreateCommand"] as DevSync.Web.Features.Teams.Workspace.Command; }
<div class="mx-auto max-w-6xl space-y-6">
    <header><a href="/teams" class="text-sm text-brand-600">← Your teams</a><div class="mt-4 flex flex-wrap justify-between gap-4"><div><h1 class="text-3xl font-semibold break-words">@Model.Team.Name</h1><p class="mt-3 text-sm text-slate-500">Team workspace · @Model.Team.Role · @Model.Total items in this view</p></div><a href="/teams/@Model.Team.Id/images" class="text-sm text-brand-600">Team images →</a><a href="/teams/@Model.Team.Id/members" class="text-sm text-brand-600">Members and invitations →</a></div></header>
    @if (TempData["Success"] is string success) { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    <form action="/teams/@Model.Team.Id" method="get" class="flex flex-wrap items-end gap-4 rounded-2xl border border-slate-200 bg-white p-5">
        <div><label for="kind" class="form-label">Content</label><select id="kind" name="kind" class="form-input"><option value="all" selected="@(Model.Kind == "all")">All content</option><option value="note" selected="@(Model.Kind == "note")">Notes</option><option value="blog" selected="@(Model.Kind == "blog")">Articles</option><option value="task" selected="@(Model.Kind == "task")">Tasks</option></select></div>
        <div><label for="archived" class="form-label">Visibility</label><select id="archived" name="archived" class="form-input"><option value="false" selected="@(!Model.Archived)">Active</option><option value="true" selected="@Model.Archived">Archived</option></select></div><button class="form-button">Apply filters</button>
    </form>
    @if (write) {
        <details open="@(draft is not null)" class="rounded-2xl border border-slate-200 bg-white p-6"><summary class="cursor-pointer font-semibold text-brand-600">Create team content</summary>
            <form action="/teams/@Model.Team.Id/items" method="post" class="mt-5 space-y-4">@Html.AntiForgeryToken()
                <partial name="_ValidationSummary" />
                <div><label for="Kind" class="form-label">Type</label><select id="Kind" name="Kind" class="form-input"><option value="note" selected="@(draft is null || draft.Kind == "note")">Note</option><option value="blog" selected="@(draft?.Kind == "blog")">Internal article</option><option value="task" selected="@(draft?.Kind == "task")">Task</option></select></div>
                <div><label for="Title" class="form-label">Title</label><input id="Title" name="Title" value="@draft?.Title" required maxlength="160" class="form-input" /></div>
                <div><label for="Body" class="form-label">Content</label><textarea id="Body" name="Body" rows="5" maxlength="50000" class="form-input">@draft?.Body</textarea><p class="mt-2 text-xs text-slate-500">Markdown headings, lists, images, links, and code. Copy image Markdown from the team image library. All team members can read this content; writers can edit it.</p></div>
                <button class="form-button">Create item</button>
            </form>
        </details>
        <details class="rounded-2xl border border-slate-200 bg-white p-6"><summary class="cursor-pointer font-semibold text-brand-600">Share a personal copy</summary><p class="mt-4 text-sm leading-7 text-slate-500">Copy a personal note, article draft, or task into this team. The team copy can be edited by team writers. Your original and future personal changes stay private. Private links are omitted; task checklist text is copied into Markdown.</p>
            @if (Model.Sources.Length == 0) { <p class="mt-4 text-sm text-slate-500">Create a personal note, article, or task first.</p> }
            @foreach (var group in Model.Sources.GroupBy(x => x.Kind)) { <form action="/teams/@Model.Team.Id/share" method="post" class="mt-5 flex flex-wrap items-end gap-3">@Html.AntiForgeryToken()<input type="hidden" name="Kind" value="@group.Key" /><div class="min-w-0 flex-1"><label for="source-@group.Key" class="form-label">Your @group.Key</label><select id="source-@group.Key" name="SourceId" class="form-input">@foreach(var s in group) { <option value="@s.Id">@s.Title</option> }</select></div><button class="form-button">Share @group.Key copy</button></form> }
        </details>
    }
    @if (Model.Items.Length == 0) { <p class="rounded-2xl border border-dashed border-slate-300 p-8 text-slate-500">No items match this view.</p> }
    <div class="grid gap-4 md:grid-cols-2">@foreach(var item in Model.Items) { <a class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 hover:border-brand-300" href="/teams/@Model.Team.Id/items/@item.Id"><p class="text-xs uppercase text-brand-600">@item.Kind</p><h2 class="mt-3 font-semibold break-words">@item.Title</h2>@if(item.Kind == "task") { <p class="mt-3 text-sm text-slate-500">@item.State · @item.Priority priority</p><p class="mt-2 text-xs text-slate-500">@(item.AssignedName ?? "Unassigned") · @(item.DueDate?.ToString("MMM d, yyyy") ?? "No deadline")</p> }</a> }</div>
    <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-slate-500"><span>Page @Model.Page of @Model.Pages</span><div class="flex gap-5">@if(Model.Page > 1) { <a href="/teams/@Model.Team.Id?kind=@Model.Kind&archived=@Model.Archived&page=@(Model.Page-1)" class="text-brand-600">Previous</a> }@if(Model.Page < Model.Pages) { <a href="/teams/@Model.Team.Id?kind=@Model.Kind&archived=@Model.Archived&page=@(Model.Page+1)" class="text-brand-600">Next</a> }</div></div>
</div>
