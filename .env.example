# Copy to .env and replace the password. Never commit .env.
POSTGRES_DB=devsync
POSTGRES_USER=devsync
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=54329
WEB_PORT=5180

# Auto saves email locally in Development; set Smtp to send real email.
EMAIL_DELIVERY=Auto
EMAIL_FROM=
EMAIL_FROM_NAME=DevSync
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
# Gmail App Password, not your normal Google password. Keep it only in .env.
EMAIL_SMTP_PASSWORD=
# Set to the public HTTPS origin for recipients on other computers.
ACCOUNT_PUBLIC_BASE_URL=http://localhost:5180
