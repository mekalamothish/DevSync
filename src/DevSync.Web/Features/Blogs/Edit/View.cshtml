@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DevSync.Web.Features.Blogs.Edit.Command
@{ ViewData["Title"] = "Article editor";
    var blockModel=new DevSync.Web.Features.Notes.Edit.Command {Id=Model.Id,Blocks=Model.Blocks,Articles=Model.Articles};
}
<div class="mx-auto max-w-5xl space-y-6">
    <header><a href="/blogs/mine" class="text-sm text-brand-600">← My blogs</a><h1 class="mt-4 text-3xl font-semibold tracking-tight">Give your idea a voice</h1><p class="mt-3 text-sm leading-7 text-slate-500">Drafts are private. Publishing shares a copy with everyone; later draft edits stay private until you publish again.</p></header>
    @if (Model.IsHidden) { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700">This article is hidden by moderation. You can save private edits; publishing remains paused until a reviewer restores it.</p> }
    @if (TempData["Success"] is string success) { <p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p> }
    <a href="/images" target="_blank" rel="noopener" class="inline-block text-sm font-semibold text-brand-600">Open image library ↗</a>
    <form id="article-editor" method="post" action="/blogs/@Model.Id/save" data-autosave="/blogs/@Model.Id/autosave" data-blocks="/blogs/@Model.Id/blocks" data-code-format="/blogs/@Model.Id/format-code" data-document-label="article" data-max-blocks="50" data-paused="@((ViewData["SavePaused"] as bool? == true).ToString().ToLowerInvariant())" data-unsaved="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
        <partial name="_ValidationSummary" />
        <div><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-input text-lg" maxlength="160" required /><span asp-validation-for="Title" class="form-error"></span></div>
        <div><label asp-for="Summary" class="form-label">Short summary</label><textarea asp-for="Summary" class="form-input" rows="3" maxlength="500" aria-describedby="summary-hint"></textarea><p id="summary-hint" class="mt-2 text-xs text-slate-500">Up to 500 characters. Required when publishing.</p><span asp-validation-for="Summary" class="form-error"></span></div>
        <div><label asp-for="Tags" class="form-label">Tags</label><input asp-for="Tags" class="form-input" maxlength="154" aria-describedby="tags-hint" placeholder="asp.net, c#, architecture" /><p id="tags-hint" class="mt-2 text-xs text-slate-500">Up to five comma-separated tags, 30 characters each.</p><span asp-validation-for="Tags" class="form-error"></span></div>
        <div class="rounded-2xl border border-brand-100 bg-brand-50/50 p-5">
            <label asp-for="EditorFormat" class="form-label">Writing editor</label>
            <select asp-for="EditorFormat" class="form-input sm:max-w-sm"><option value="markdown">Markdown</option><option value="blocks">Study Notes blocks</option><option value="richtext">Rich text · Tiptap</option></select>
            <p class="mt-3 text-xs leading-6 text-slate-500">Each editor keeps its own draft content. Switching editors does not convert or erase the other versions. Preview and publishing use the selected editor.</p>
        </div>
        <section data-editor-panel="markdown" class="space-y-4" aria-label="Markdown editor">
        <div><label asp-for="Markdown" class="form-label"></label><p id="markdown-hint" class="mb-3 text-xs leading-6 text-slate-500">Use # headings, - lists, `inline code`, [links](https://example.com), ![Image description](https://example.com/image.png), and triple backticks for code blocks. Use uploaded images from your image library or public HTTPS URLs. Private images require library access. HTML is shown as text. Save before opening preview.</p><textarea asp-for="Markdown" class="form-input min-h-96 font-mono leading-7" rows="18" maxlength="60000" aria-describedby="markdown-hint" placeholder="Share what you've learned…"></textarea><span asp-validation-for="Markdown" class="form-error"></span></div>
        </section>
        <section data-editor-panel="richtext" class="space-y-4" aria-label="Tiptap article editor">
            <h2 class="text-lg font-semibold">Rich text article</h2>
            @await Html.PartialAsync("_RichTextEditor",new DevSync.Web.Common.Content.RichTextEditorModel("RichText","RichText",Model.RichText))
            <span asp-validation-for="RichText" class="form-error"></span>
        </section>
        <section data-editor-panel="blocks" class="space-y-4" aria-label="Article block editor">
            <h2 class="text-lg font-semibold">Article blocks</h2>
            <p class="text-xs text-slate-500">The same text, heading, code, checklist, article link and rich text blocks as Study Notes.</p>
            <div id="note-blocks" class="space-y-4">@for(var i=0;i<Model.Blocks.Count;i++) { @await Html.PartialAsync("~/Features/Notes/Edit/_Block.cshtml",blockModel,new ViewDataDictionary(ViewData){["BlockIndex"]=i,["BlockRoute"]=$"/blogs/{Model.Id}/blocks"}) }</div>
            <p id="note-blocks-empty" hidden="@(Model.Blocks.Count!=0)" class="rounded-xl border border-dashed border-slate-200 p-6 text-sm text-slate-500">Add your first article block below.</p>
            <div class="flex flex-wrap items-end gap-3 rounded-xl bg-brand-50 p-4"><div class="min-w-48 flex-1"><label for="note-block-kind" class="form-label">Add a block</label><select id="note-block-kind" name="kind" class="form-input"><option value="paragraph">Text</option><option value="heading">Heading</option><option value="code">Code snippet</option><option value="checklist">Checklist</option><option value="article">Linked article</option><option value="richtext">Rich text · Tiptap</option></select></div><button id="note-add-block" type="submit" formaction="/blogs/@Model.Id/blocks?operation=add" data-block-action="add" class="form-button">Add block ＋</button></div>
        </section>
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-6">
            <p id="save-status" class="text-xs text-slate-500" role="status" aria-live="polite">Autosave starts when you edit. You can always save manually.</p>
            <div class="flex flex-wrap items-center gap-3"><a id="article-preview" class="px-3 py-3 text-sm text-brand-600" href="/blogs/@Model.Id/preview" target="_blank" rel="noopener">Preview ↗</a><button class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold" type="submit">Save draft</button><button class="form-button" type="submit" formaction="/blogs/@Model.Id/publish" disabled="@Model.IsHidden">Publish article</button></div>
        </div>
        @if (Model.PublishedUrl is not null) { <a href="@Model.PublishedUrl" class="inline-block text-sm text-brand-600">View published copy →</a> }
    </form>
    <datalist id="code-languages">@foreach(var language in new[]{"C#","JavaScript","TypeScript","JSON","HTML","CSS","SQL","Python","XML","YAML","Markdown","Text"}) { <option value="@language"></option> }</datalist>
    @foreach(var kind in DevSync.Web.Features.Notes.Edit.Handler.Kinds) { <template id="note-template-@kind">@await Html.PartialAsync("~/Features/Notes/Edit/_Block.cshtml",blockModel,new ViewDataDictionary(ViewData){["BlockIndex"]=-1,["BlockKind"]=kind,["BlockRoute"]=$"/blogs/{Model.Id}/blocks"})</template> }
</div>
@section Scripts { <link rel="stylesheet" href="~/vendor/code/note-code.css" asp-append-version="true" /><script src="~/js/note-editor.js" asp-append-version="true" defer></script><script type="module" src="~/vendor/code/rich-text.js" asp-append-version="true"></script><script type="module" src="~/vendor/code/note-code.js" asp-append-version="true"></script> }
