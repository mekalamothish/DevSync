@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model DevSync.Web.Features.Notes.Edit.Command
@{
    ViewData["Title"] = Model.IsArchived ? "Archived note" : "Note editor";
    var paused = ViewData["SavePaused"] as bool? == true;
}
<div class="mx-auto max-w-5xl space-y-6">
    <header><a href="/notes" class="text-sm text-brand-600">← My notes</a><div class="mt-4 flex flex-wrap items-center justify-between gap-3"><h1 class="text-3xl font-semibold tracking-tight">@(Model.IsArchived ? "An idea kept for later" : "Make room for what you learn")</h1><span class="rounded-full bg-brand-50 px-3 py-1.5 text-xs font-medium text-brand-700">Private note</span></div><p class="mt-3 text-sm leading-7 text-slate-500">Build your note with text, headings, code, checklists, rich text, and article links. Save before opening the preview.</p></header>
    @if (TempData["Success"] is string success) { <p class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@success</p> }
    @if (Model.IsArchived)
    {
        <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-brand-100 bg-brand-50 p-5"><p class="text-sm text-brand-700">This note is archived. Restore it to make changes.</p><form method="post" action="/notes/@Model.Id/restore">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Version" /><button class="form-button" type="submit">Restore note</button></form></div>
    }
    <form id="note-editor" method="post" action="/notes/@Model.Id/save" data-code-format="/notes/@Model.Id/format-code" data-autosave="/notes/@Model.Id/autosave" data-blocks="/notes/@Model.Id/blocks" data-max-blocks="50" data-archived="@Model.IsArchived.ToString().ToLowerInvariant()" data-paused="@paused.ToString().ToLowerInvariant()" data-unsaved="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())" class="space-y-6">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
        <partial name="_ValidationSummary" />
        <fieldset disabled="@Model.IsArchived" class="space-y-6">
            <div class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
                @await Html.PartialAsync("_CoverEditor", new DevSync.Web.Common.Content.CoverEditorModel(Model.CoverImageId, false))
                <div><label asp-for="Title" class="form-label">Note title</label><input asp-for="Title" class="form-input text-lg" maxlength="160" required placeholder="What are you learning?" /><span asp-validation-for="Title" class="form-error"></span></div>
                <div class="grid gap-5 sm:grid-cols-2"><div><label asp-for="NotebookId" class="form-label">Notebook</label><select asp-for="NotebookId" class="form-input"><option value="">No notebook</option>@foreach (var notebook in Model.Notebooks) { <option value="@notebook.Id">@notebook.Name</option> }</select><span asp-validation-for="NotebookId" class="form-error"></span></div><div><label asp-for="Tags" class="form-label">Tags</label><input asp-for="Tags" class="form-input" maxlength="154" aria-describedby="note-tags-hint" placeholder="c#, databases, architecture" /><p id="note-tags-hint" class="mt-2 text-xs leading-6 text-slate-500">Up to five comma-separated tags, 30 characters each.</p><span asp-validation-for="Tags" class="form-error"></span></div></div>
            </div>
            <div><div class="mb-3 flex flex-wrap items-center justify-between gap-3"><h2 class="text-lg font-semibold">Note blocks</h2><p class="text-xs text-slate-500">Up to 50 blocks · 60,000 characters in total</p></div><div id="note-blocks" class="space-y-4">@for (var i = 0; i < Model.Blocks.Count; i++) { @await Html.PartialAsync("_Block.cshtml", Model, new ViewDataDictionary(ViewData) { ["BlockIndex"] = i }) }</div><p id="note-blocks-empty" hidden="@(Model.Blocks.Count != 0)" class="rounded-2xl border border-dashed border-slate-200 bg-white p-8 text-center text-sm text-slate-500">Choose a block below to begin your note.</p></div>
            <div class="flex flex-wrap items-end gap-3 rounded-2xl border border-dashed border-brand-100 bg-brand-50/50 p-5"><div class="min-w-48 flex-1"><label for="note-block-kind" class="form-label">Add a block</label><select id="note-block-kind" name="kind" class="form-input"><option value="paragraph">Text</option><option value="heading">Heading</option><option value="code">Code snippet</option><option value="richtext">Rich text · Tiptap</option><option value="checklist">Checklist</option><option value="article">Linked article</option></select></div><button id="note-add-block" type="submit" formaction="/notes/@Model.Id/blocks?operation=add" data-block-action="add" class="rounded-xl border border-brand-100 bg-white px-5 py-3 text-sm font-semibold text-brand-700">Add block ＋</button></div>
            <noscript><p class="rounded-xl border border-brand-100 bg-brand-50 p-4 text-sm leading-7 text-brand-700">Save note and block controls work without JavaScript. Adding, moving, or removing a block also saves the fields currently shown.</p></noscript>
            <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5"><p id="note-save-status" class="text-xs leading-6 text-slate-500" role="status" aria-live="polite">Saved note. Autosave starts when you edit.</p><div class="flex flex-wrap gap-3"><a href="/notes/@Model.Id/preview" class="px-3 py-3 text-sm text-brand-600" target="_blank" rel="noopener">Saved preview ↗</a><button class="form-button" type="submit">Save note</button></div></div>
        </fieldset>
        @if (Model.IsArchived) { <a href="/notes/@Model.Id/preview" class="inline-block text-sm font-semibold text-brand-600">Read archived note →</a> }
    </form>
    <datalist id="code-languages">@foreach(var language in new[]{"C#","JavaScript","TypeScript","JSON","HTML","CSS","SQL","Python","XML","YAML","Markdown","Text"}) { <option value="@language"></option> }</datalist>
    @foreach (var kind in new[] { "paragraph", "heading", "code", "checklist", "article", "richtext" })
    {
        <template id="note-template-@kind">@await Html.PartialAsync("_Block.cshtml", Model, new ViewDataDictionary(ViewData) { ["BlockIndex"] = -1, ["BlockKind"] = kind })</template>
    }
</div>
@section Scripts { <script src="~/js/cover-editor.js" asp-append-version="true" defer></script> <link rel="stylesheet" href="~/vendor/code/note-code.css" asp-append-version="true" /><script type="module" src="~/vendor/code/rich-text.js" asp-append-version="true"></script><script type="module" src="~/vendor/code/note-code.js" asp-append-version="true"></script> <script src="~/js/note-editor.js" asp-append-version="true" defer></script> }
