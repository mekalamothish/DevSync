@if (User.Identity?.IsAuthenticated == true)
{
    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <a href="/account/profile" class="rounded-xl bg-brand-50 px-2.5 py-2 text-sm font-medium text-brand-700 sm:px-3">My profile</a>
        <form asp-controller="Account" asp-action="SignOut" method="post"><button type="submit" class="text-sm text-slate-500 hover:text-brand-600">Sign out</button></form>
        <partial name="_ThemeToggle" />
    </div>
}
else
{
    <div class="flex shrink-0 items-center gap-2 sm:gap-4">
        <a href="/account/register" aria-label="Join DevSync" class="rounded-xl bg-brand-600 px-3 py-2 text-sm font-medium text-white hover:bg-brand-700"><span class="sm:hidden">Join</span><span class="hidden sm:inline">Join DevSync</span></a>
        <a href="/account/sign-in" class="text-sm font-medium text-slate-500 hover:text-brand-600">Sign in</a>
        <partial name="_ThemeToggle" />
    </div>
}
