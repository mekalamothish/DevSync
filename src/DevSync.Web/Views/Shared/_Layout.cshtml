@using Microsoft.Extensions.DependencyInjection
@{ var reduceMotion = false; if (Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var preferenceUser)) { reduceMotion = (await Context.RequestServices.GetRequiredService<DevSync.Web.Features.Settings.Handler>().LoadAsync(preferenceUser, Context.RequestAborted)).ReduceMotion; } }
<!DOCTYPE html>
<html lang="en" class="@(reduceMotion ? "reduce-motion" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="DevSync brings developer knowledge, study notes, tasks, and teamwork into one workspace." />
    <title>@ViewData["Title"] · DevSync</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <a href="#main-content" class="sr-only z-50 rounded-lg bg-white p-3 text-brand-700 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <div class="lg:grid lg:min-h-screen lg:grid-cols-[248px_1fr]">
        <partial name="_Sidebar" />
        <div class="min-w-0">
            <header class="workspace-topbar sticky top-0 z-20 flex h-18 items-center justify-between gap-3 border-b border-slate-200/70 bg-white/95 px-5 backdrop-blur sm:px-8">
                <div class="flex items-center gap-3">
                    <button type="button" id="navigation-toggle" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation" class="flex size-10 items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 lg:hidden">
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>
                    <span class="hidden text-sm font-medium text-slate-500 sm:block">Workspace <span class="mx-2 text-slate-300" aria-hidden="true">/</span> <span class="text-ink">@ViewData["Title"]</span></span>
                    <span class="hidden text-sm font-semibold min-[380px]:inline sm:hidden">DevSync</span>
                </div>
                <partial name="_AccountMenu" />
            </header>
            <main id="main-content" tabindex="-1" class="workspace-content px-5 py-8 sm:px-8 lg:px-10 lg:py-10">
                @RenderBody()
            </main>
            <footer class="mx-5 mt-6 flex flex-wrap justify-between gap-3 border-t border-slate-200/70 py-6 text-xs text-slate-600 sm:mx-8 lg:mx-10">
                <span>DevSync · A space to keep growing.</span>
                <span>Made for developers</span>
            </footer>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
