@model DevSync.Web.Features.Notes.List.ViewModel
@{ ViewData["Title"] = "My notes"; }
<div class="mx-auto max-w-6xl space-y-8">
    <header class="flex flex-wrap items-end justify-between gap-5">
        <div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-600">Your learning workspace</p><h1 class="text-4xl font-semibold tracking-tight">My notes</h1><p class="mt-3 max-w-xl text-sm leading-7 text-slate-500">Keep ideas, code, checklists, and articles together. Your notebooks and notes are private.</p></div>
        <form method="post" action="/notes/create">@Html.AntiForgeryToken()<input type="hidden" name="NotebookId" value="@Model.NotebookId" /><button class="form-button" type="submit">New note ＋</button></form>
    </header>
    @if (TempData["Success"] is string success) { <p class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@success</p> }
    @if (TempData["Error"] is string error) { <p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">@error</p> }
    <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-brand-100 bg-brand-50 p-5"><p class="text-sm text-brand-700">Active notes</p><p class="mt-2 text-3xl font-semibold">@Model.Active</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Notebooks</p><p class="mt-2 text-3xl font-semibold">@Model.Notebooks.Count</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm text-slate-500">Archived notes</p><p class="mt-2 text-3xl font-semibold">@Model.Archived</p></div>
    </div>
    <div class="grid items-start gap-6 lg:grid-cols-[15rem_1fr]">
        <aside class="space-y-6 rounded-2xl border border-slate-200 bg-white p-5" aria-label="Notebook organization">
            <div><h2 class="text-sm font-semibold">Notebooks</h2><nav class="mt-3 space-y-1 text-sm" aria-label="Choose notebook"><a class="block rounded-lg px-3 py-2 @(Model.NotebookId is null ? "bg-brand-50 font-semibold text-brand-700" : "text-slate-500")" href="/notes?archived=@Model.ShowArchived.ToString().ToLowerInvariant()">All notebooks</a>@foreach (var notebook in Model.Notebooks) { <a class="block break-words rounded-lg px-3 py-2 @(Model.NotebookId == notebook.Id ? "bg-brand-50 font-semibold text-brand-700" : "text-slate-500")" href="/notes?notebookId=@notebook.Id&archived=@Model.ShowArchived.ToString().ToLowerInvariant()">@notebook.Name</a> }</nav></div>
            <form method="post" action="/notes/notebooks" class="space-y-3 border-t border-slate-100 pt-5">@Html.AntiForgeryToken()<label for="new-notebook-name" class="form-label">Create a notebook</label><input id="new-notebook-name" name="Name" class="form-input" maxlength="80" required placeholder="e.g. ASP.NET learning" /><button class="w-full rounded-xl border border-brand-100 px-4 py-3 text-sm font-semibold text-brand-700" type="submit">Add notebook</button></form>
            @if (Model.Tags.Count > 0)
            {
                <div class="border-t border-slate-100 pt-5"><h2 class="text-sm font-semibold">Your tags</h2><div class="mt-3 flex flex-wrap gap-2">@foreach (var tag in Model.Tags) { <a class="rounded-full bg-brand-50 px-3 py-1.5 text-xs text-brand-700" href="/notes?tag=@Uri.EscapeDataString(tag)&archived=@Model.ShowArchived.ToString().ToLowerInvariant()">#@tag</a> }</div></div>
            }
        </aside>
        <div class="min-w-0 space-y-5">
            <nav class="flex gap-5 border-b border-slate-200 text-sm" aria-label="Note status"><a class="border-b-2 pb-3 @(Model.ShowArchived ? "border-transparent text-slate-500" : "border-brand-600 font-semibold text-brand-600")" href="/notes" aria-current="@(Model.ShowArchived ? null : "page")">Active (@Model.Active)</a><a class="border-b-2 pb-3 @(Model.ShowArchived ? "border-brand-600 font-semibold text-brand-600" : "border-transparent text-slate-500")" href="/notes?archived=true" aria-current="@(Model.ShowArchived ? "page" : null)">Archived (@Model.Archived)</a></nav>
            <form method="get" action="/notes" class="grid items-end gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-[1fr_10rem_auto]">
                <input type="hidden" name="notebookId" value="@Model.NotebookId" /><input type="hidden" name="archived" value="@Model.ShowArchived.ToString().ToLowerInvariant()" />
                <div><label for="note-search" class="form-label">Search your notes</label><input id="note-search" name="search" class="form-input" value="@Model.Search" maxlength="200" placeholder="Search titles and block text" /></div>
                <div><label for="note-tag" class="form-label">Tag</label><select id="note-tag" name="tag" class="form-input"><option value="">All tags</option>@foreach (var tag in Model.Tags) { <option value="@tag" selected="@(Model.Tag == tag)">@tag</option> }</select></div>
                <button class="form-button" type="submit">Filter</button>
            </form>
            <p class="text-xs text-slate-500">@Model.Total @(Model.Total == 1 ? "note" : "notes")@(Model.ShowArchived ? " in archive" : " found")</p>
            @if (Model.Notes.Count == 0)
            {
                <section class="rounded-2xl border border-dashed border-slate-200 bg-white px-6 py-12 text-center">
                    <h2 class="text-xl font-semibold">@(Model.Search.Length > 0 || Model.Tag.Length > 0 || Model.NotebookId is not null ? "No notes match these filters" : Model.ShowArchived ? "Your archive is clear" : "Build a home for your ideas")</h2>
                    <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">@(Model.Search.Length > 0 || Model.Tag.Length > 0 || Model.NotebookId is not null ? "Try another search, or clear the filters to see all your notes." : Model.ShowArchived ? "Archived notes will appear here. You can restore them whenever you need them." : "Start a note, add the blocks you need, and organize it in a notebook.")</p>
                    @if (Model.Search.Length > 0 || Model.Tag.Length > 0 || Model.NotebookId is not null) { <a class="mt-5 inline-block text-sm font-semibold text-brand-600" href="/notes?archived=@Model.ShowArchived.ToString().ToLowerInvariant()">Clear filters →</a> }
                </section>
            }
            <div class="grid gap-4 sm:grid-cols-2">
                @foreach (var note in Model.Notes)
                {
                    <article class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 transition-[background-color,border-color,box-shadow] hover:border-brand-200 hover:bg-brand-50/50 hover:shadow-md hover:shadow-brand-100/70 focus-within:border-brand-200 focus-within:shadow-md">
                        @if(note.CoverImageId is not null) { <a href="/notes/@note.Id/preview" tabindex="-1" aria-hidden="true" class="-mx-5 -mt-5 mb-5 block overflow-hidden"><img src="/notes/@note.Id/cover" alt="" loading="lazy" decoding="async" class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" /></a> }
                        <p class="break-words text-xs text-slate-500">@(note.NotebookName ?? "No notebook") · @note.BlockCount @(note.BlockCount == 1 ? "block" : "blocks")</p>
                        <h2 class="mt-3 break-words text-xl font-semibold"><a href="/notes/@note.Id/preview" class="transition-colors group-hover:text-brand-700 hover:underline underline-offset-4">@note.Title</a></h2>
                        <div class="mt-3 flex flex-wrap gap-2">@foreach (var tag in note.Tags) { <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs text-brand-700">#@tag</span> }</div>
                        <p class="mb-5 mt-4 text-xs text-slate-500">Updated <time datetime="@note.UpdatedAt.ToString("O")">@note.UpdatedAt.ToString("MMM d, yyyy HH:mm 'UTC'")</time></p>
                        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 text-sm"><a class="font-semibold text-brand-600" href="/notes/@note.Id">@(note.IsArchived ? "View note" : "Edit note") →</a><form method="post" action="/notes/@note.Id/@(note.IsArchived ? "restore" : "archive")">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@note.Version" /><button class="text-xs text-slate-500 underline underline-offset-4" type="submit">@(note.IsArchived ? "Restore" : "Archive")</button></form></div>
                    </article>
                }
            </div>
            @if (Model.Total > 0)
            {
                <nav class="flex items-center justify-between gap-3 text-sm text-brand-600" aria-label="Note pages">
                    @if (Model.Page > 1) { <a href="/notes?search=@Uri.EscapeDataString(Model.Search)&notebookId=@Model.NotebookId&tag=@Uri.EscapeDataString(Model.Tag)&archived=@Model.ShowArchived.ToString().ToLowerInvariant()&page=@(Model.Page - 1)">← Previous</a> }
                    <span class="text-slate-500">Page @Model.Page of @Model.Pages</span>
                    @if (Model.Page < Model.Pages) { <a href="/notes?search=@Uri.EscapeDataString(Model.Search)&notebookId=@Model.NotebookId&tag=@Uri.EscapeDataString(Model.Tag)&archived=@Model.ShowArchived.ToString().ToLowerInvariant()&page=@(Model.Page + 1)">Next →</a> }
                </nav>
            }
        </div>
    </div>
</div>
