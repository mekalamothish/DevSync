@model DevSync.Web.Features.Moderation.VerificationModel
@{ViewData["Title"]="Review verification";var paused=ViewData["Paused"] as bool?==true;}
<div class="mx-auto max-w-3xl space-y-6"><header><a href="/moderation" class="text-sm text-brand-600">← Review queue</a><h1 class="mt-4 text-3xl font-semibold">Publisher verification</h1></header>
@if(TempData["Success"] is string success){<p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p>}
<div class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-brand-600">@Model.Request.Status</p><p class="mt-3 break-all text-sm">@Model.Request.EvidenceUrl</p><p class="mt-4 whitespace-pre-wrap break-words text-sm leading-7">@Model.Request.Statement</p><p class="mt-4 text-xs text-slate-500">Evidence is private. Assess the public link manually; this application does not download evidence.</p></div>
<partial name="_ValidationSummary"/>
@if(paused){<p class="text-sm text-red-700">This request changed. Reload before submitting another decision.</p>}
@if(Model.Request.Status is "pending" or "approved"){<form method="post" action="/moderation/verification/@Model.Request.Id" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Request.Version"/><label for="Reason" class="form-label">Decision reason</label><textarea id="Reason" name="Reason" required maxlength="2000" rows="4" class="form-input">@(Context.Request.HasFormContentType ? Context.Request.Form["Reason"].ToString() : "")</textarea><div class="flex flex-wrap gap-3">@if(Model.Request.Status=="pending"){<button name="Action" value="approve" class="form-button" disabled="@paused">Approve badge</button><button name="Action" value="reject" class="rounded-xl border border-slate-200 px-5 py-3 text-sm" disabled="@paused">Reject request</button>}else{<button name="Action" value="revoke" class="form-button" disabled="@paused">Revoke badge</button>}</div></form>}
<section class="rounded-2xl border border-slate-200 bg-white p-6"><h2 class="font-semibold">Audit history</h2><ul class="mt-4 space-y-4">@foreach(var a in Model.Audits){<li class="text-sm break-words"><span class="font-medium">@a.Action</span> · @a.Reason <span class="block mt-1 text-xs text-slate-500">@a.At.ToString("MMM d, yyyy HH:mm") UTC</span></li>}</ul></section></div>
