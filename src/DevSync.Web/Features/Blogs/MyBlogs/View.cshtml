@model DevSync.Web.Features.Blogs.MyBlogs.ViewModel
@{ ViewData["Title"] = "My blogs"; }
<div class="mx-auto max-w-6xl space-y-8">
    <header class="flex flex-wrap items-end justify-between gap-5">
        <div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-brand-600">Your author workspace</p><h1 class="text-4xl font-semibold tracking-tight">My blogs</h1><p class="mt-3 text-sm text-slate-500">Write at your pace. Publish when you're ready.</p></div>
        <form method="post" action="/blogs/create">@Html.AntiForgeryToken()<button class="form-button" type="submit">New article ＋</button></form>
    </header>
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6"><p class="text-sm text-brand-700">Private drafts</p><p class="mt-2 text-3xl font-semibold">@Model.Drafts</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-sm text-slate-500">Published articles</p><p class="mt-2 text-3xl font-semibold">@Model.Published</p></div>
    </div>
    @if (Model.Articles.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-12 text-center"><h2 class="text-xl font-semibold">Every article starts with an idea</h2><p class="mt-3 text-sm text-slate-500">Create your first draft with New article. Only you can see it until you publish.</p></div>
    }
    <div class="grid gap-6 md:grid-cols-2">
    @foreach (var article in Model.Articles)
    {
        <article class="flex flex-col overflow-hidden rounded-3xl border border-slate-200/70 bg-white">
            @if(article.CoverImageId is not null) { <a href="/blogs/@article.Id/preview" tabindex="-1" aria-hidden="true"><img src="/blogs/@article.Id/cover?draft=true" alt="" class="aspect-video w-full object-cover" loading="lazy" decoding="async" /></a> }
            <div class="flex flex-1 flex-col justify-between gap-5 p-6">
            <div><span class="rounded-full bg-brand-50 px-3 py-1 text-xs text-brand-700">@(article.IsHidden ? "Hidden by moderation" : article.Slug is null ? "Draft" : article.HasChanges ? "Published · unpublished edits" : "Published")</span><h2 class="mt-3 text-xl font-semibold">@article.Title</h2><p class="mt-2 text-xs text-slate-500">Updated @article.UpdatedAt.ToString("MMM d, yyyy HH:mm 'UTC'")</p></div>
            <div class="flex gap-4 text-sm"><a class="font-semibold text-brand-600" href="/blogs/@article.Id/edit">Edit article</a>@if (article.Slug is not null && !article.IsHidden) { <a class="text-slate-500" href="/blogs/@article.Slug">Read →</a> }</div>
            </div>
        </article>
    }
    </div>
    <nav class="flex justify-between text-sm text-brand-600" aria-label="My blog pages">
        @if (Model.Page > 1) { <a href="/blogs/mine?page=@(Model.Page - 1)">← Previous</a> }
        <span class="text-slate-500">Page @Model.Page of @Model.Pages</span>
        @if (Model.Page < Model.Pages) { <a href="/blogs/mine?page=@(Model.Page + 1)">Next →</a> }
    </nav>
</div>
