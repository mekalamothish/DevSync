@model DevSync.Web.Features.Moderation.ReportModel
@{ViewData["Title"]="Review report";var paused=ViewData["Paused"] as bool?==true;}
<div class="mx-auto max-w-3xl space-y-6"><header><a href="/moderation" class="text-sm text-brand-600">← Review queue</a><h1 class="mt-4 text-3xl font-semibold">Review content report</h1></header>
@if(TempData["Success"] is string success){<p class="rounded-xl bg-brand-50 p-4 text-sm text-brand-700" role="status">@success</p>}
<div class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-brand-600">@Model.Report.Kind · @Model.Report.Category · @Model.Report.Status</p><p class="mt-4 whitespace-pre-wrap break-words text-sm leading-7">@Model.Report.Excerpt</p><h2 class="mt-5 font-semibold">Reporter explanation</h2><p class="mt-3 whitespace-pre-wrap break-words text-sm">@Model.Report.Details</p><p class="mt-4 text-xs text-slate-500">@(Model.TargetExists ? Model.Hidden ? "Content is hidden." : "Content is visible." : "The original content was removed.")</p></div>
<partial name="_ValidationSummary"/>@if(paused){<p class="text-sm text-red-700">The report or content changed. Reload before acting.</p>}
<form method="post" action="/moderation/reports/@Model.Report.Id" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-6">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@Model.Report.Version"/><input type="hidden" name="TargetVersion" value="@Model.TargetVersion"/><label for="Reason" class="form-label">Action reason</label><textarea id="Reason" name="Reason" required maxlength="2000" rows="4" class="form-input">@(Context.Request.HasFormContentType ? Context.Request.Form["Reason"].ToString() : "")</textarea><div class="flex flex-wrap gap-3">@if(Model.TargetExists){<button name="Action" value="@(Model.Hidden ? "restore" : "hide")" class="form-button" disabled="@paused">@(Model.Hidden ? "Restore content" : "Hide content")</button>}@if(Model.Report.Status=="pending"){<button name="Action" value="dismiss" class="rounded-xl border border-slate-200 px-5 py-3 text-sm" disabled="@paused">Dismiss report</button>}</div></form>
<section class="rounded-2xl border border-slate-200 bg-white p-6"><h2 class="font-semibold">Audit history</h2><ul class="mt-4 space-y-4">@foreach(var a in Model.Audits){<li class="text-sm break-words"><span class="font-medium">@a.Action</span> · @a.Reason <span class="block mt-1 text-xs text-slate-500">@a.At.ToString("MMM d, yyyy HH:mm") UTC</span></li>}</ul></section></div>
