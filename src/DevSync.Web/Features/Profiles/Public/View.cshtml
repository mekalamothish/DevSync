@model DevSync.Web.Features.Profiles.Public.ViewModel
@{ViewData["Title"]=Model.Name;}
<div class="mx-auto max-w-6xl space-y-7"><header class="rounded-2xl border border-slate-200 bg-white p-7"><p class="text-sm text-brand-600">@@@Model.Handle</p><h1 class="mt-3 text-3xl font-semibold break-words">@Model.Name</h1>@if(Model.Verified){<p class="mt-3 text-sm font-medium text-brand-600">Verified publisher</p>}@if(!string.IsNullOrWhiteSpace(Model.Bio)){<p class="mt-4 whitespace-pre-wrap break-words text-sm leading-7 text-slate-600">@Model.Bio</p>}<p class="mt-4 text-xs text-slate-500">@Model.Total published articles</p></header>
@if(Model.Articles.Count==0){<p class="rounded-2xl border border-dashed border-slate-300 p-8 text-slate-500">No published articles to show.</p>}
<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">@foreach(var article in Model.Articles){<partial name="_ArticleCard" model="article"/>}</div>
<div class="flex gap-5 text-sm text-brand-600"><span class="text-slate-500">Page @Model.Page of @Model.Pages</span>@if(Model.Page>1){<a href="/people/@Model.Handle?page=@(Model.Page-1)">Previous</a>}@if(Model.Page<Model.Pages){<a href="/people/@Model.Handle?page=@(Model.Page+1)">Next</a>}</div></div>
